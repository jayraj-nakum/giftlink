# Copy to .env.local (npm run setup does this for you).

# Public URL of the site, used to build share links.
# On Vercel you can leave this out: the project's production domain is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: a local SQLite file by default.
# Production: a Turso (libSQL) URL, e.g. libsql://your-db.turso.io plus DATABASE_AUTH_TOKEN.
# The Turso integration on Vercel sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead; both work.
# On Vercel, `npm run vercel-build` applies the migrations in ./drizzle before every build.
DATABASE_URL=file:./data/giftlink.db
DATABASE_AUTH_TOKEN=

# Price in paise (19900 = ₹199) and how many days a link stays live.
PRICE_PAISE=19900
LINK_LIFETIME_DAYS=90

# Payments: "mock" (a fake checkout for local testing) or "razorpay".
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Mock payments are refused in production unless this is "true" (for staging only).
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# Photo storage: "local" (./data/uploads, served from /media), "blob" (Vercel Blob, needs
# BLOB_READ_WRITE_TOKEN, which connecting a Blob store adds) or "r2" (Cloudflare R2 / any S3).
# Left empty, it is "blob" when BLOB_READ_WRITE_TOKEN is set, else "local".
# BLOB_ACCESS must match the Blob store: "private" (Vercel's default) or "public".
BLOB_ACCESS=private
STORAGE_DRIVER=local
R2_ENDPOINT=            # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=     # https://media.yourdomain.com (public bucket domain)

# Protects /api/cron/cleanup (send "Authorization: Bearer <secret>").
CRON_SECRET=change-me
